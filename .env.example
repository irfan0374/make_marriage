# Every environment variable the app will ever need, grouped by service.
# Copy to .env.local and fill in. Dummy or empty values only; never commit real values.
# Validated at startup by src/lib/env.ts. Only App and MongoDB are required today; the other
# services are optional until their feature is built, then they become required.
# Empty values (KEY=) count as "not set".

# --- App (required, Phase 0) ---
# Public base URL, used to build guest and member-invite links.
APP_URL=http://localhost:3000
# Optional: debug | info | warn | error (default info).
LOG_LEVEL=info

# --- MongoDB Atlas (required, Phase 0) ---
# Dev cluster connection string (Mumbai).
MONGODB_URI=
MONGODB_DB_NAME=make_marriage_dev
# Optional: connection pool size per function instance (default 5).
MONGODB_MAX_POOL_SIZE=5

# --- Resend email (optional now; required in Phase 1: password reset, member invites, invitations) ---
RESEND_API_KEY=
# Phase 1: signature secret for delivery and bounce webhooks (/api/webhooks/resend).
RESEND_WEBHOOK_SECRET=
# Phase 1: verified sending address, "Name <email>" or an email.
EMAIL_FROM="Wedding <hello@example.com>"
# Phase 1: daily send cap (100 on Resend's free tier; default 100).
EMAIL_DAILY_LIMIT=100

# --- Cloudflare R2 (optional now; required in Phase 1: invitation media; later receipts, vendor files, gallery) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=make-marriage-dev

# --- Cron (optional now; required in Phase 1: bulk email queue) ---
# Bearer secret for /api/cron/*, at least 32 random characters.
CRON_SECRET=

# --- Google Places (optional now; required at the end of Phase 4: wedding location and vendor search) ---
GOOGLE_PLACES_API_KEY=

# --- Tests: put this in .env.test.local, not .env.local ---
# Dedicated Atlas cluster/user for integration tests. Each test file creates and drops its own
# test_* database; nothing else is touched. Leave unset to skip integration tests.
# TEST_MONGODB_URI=
