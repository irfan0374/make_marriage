# Every environment variable the app will ever need, grouped by service.
# Copy to .env.local and fill in. Dummy or empty values only; never commit real values.
# Validated at startup by src/lib/env.ts. Only App and MongoDB are required today; the other
# services are optional until their feature is built, then they become required.
# Empty values (KEY=) count as "not set".

# --- App (required, Phase 0) ---
# Public base URL, used to build guest and member-invite links.
APP_URL=http://localhost:3000
# Optional: debug | info | warn | error (default info).
LOG_LEVEL=info

# --- MongoDB Atlas (required, Phase 0) ---
# Dev cluster connection string (Mumbai).
MONGODB_URI=
MONGODB_DB_NAME=make_marriage_dev
# Optional: connection pool size per function instance (default 5).
MONGODB_MAX_POOL_SIZE=5

# --- Resend email (required since member invites) ---
# API key from resend.com (starts with re_).
RESEND_API_KEY=
# Sender, "Name <email>" or an email, on a domain verified in Resend. The resend.dev test
# address only delivers to your own Resend account's email.
EMAIL_FROM="Make My Marriage <invites@example.com>"
# Signature secret (whsec_…) for delivery and bounce webhooks (/api/webhooks/resend). Optional in
# development (Resend can't reach localhost); set it in production when you add the webhook in
# Resend → Webhooks with the events email.delivered, email.bounced and email.complained.
RESEND_WEBHOOK_SECRET=
# Optional: daily send cap for bulk email (100 on Resend's free tier; default 100).
EMAIL_DAILY_LIMIT=100
# Optional, development only: send every email to this address instead of the real recipient
# (useful while EMAIL_FROM is Resend's test sender, which only delivers to the account owner).
# Ignored in production.
EMAIL_DEV_REDIRECT_TO=

# --- Cloudflare R2 (required since invitation cards; later receipts, vendor files, gallery) ---
# Cloudflare dashboard → R2: Account ID from "Account Details"; an API token with Object Read & Write
# on this bucket gives the access key and secret. The bucket needs a CORS rule allowing PUT/GET/HEAD
# from the app's origin with the Content-Type and Content-Length headers.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=make-marriage-dev

# --- Cron (required since bulk email): cron-job.org calls /api/cron/process-jobs every minute ---
# Bearer secret for /api/cron/*, at least 32 random characters.
CRON_SECRET=

# --- Google Places (optional now; required at the end of Phase 4: wedding location and vendor search) ---
GOOGLE_PLACES_API_KEY=

# --- Tests: put this in .env.test.local, not .env.local ---
# Dedicated Atlas cluster/user for integration tests. Each test file creates and drops its own
# test_* database; nothing else is touched. Leave unset to skip integration tests.
# TEST_MONGODB_URI=
