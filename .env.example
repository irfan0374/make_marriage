# Copy to .env.local (app, scripts) and fill in. Never commit real values.
# Variables are validated at startup by src/lib/env.ts; new ones are added phase by phase.

# Public base URL of the app, used to build guest and invite links.
APP_URL=http://localhost:3000

# MongoDB Atlas (Mumbai). Dev cluster connection string and database name.
MONGODB_URI=
MONGODB_DB_NAME=make_marriage_dev
# Optional: connection pool size per function instance (default 5).
# MONGODB_MAX_POOL_SIZE=5

# Optional: debug | info | warn | error (default info).
# LOG_LEVEL=info

# --- Tests: put this in .env.test.local, not .env.local ---
# Dedicated Atlas cluster/user for integration tests. Each run creates and drops its own
# test_* databases; nothing else is touched. Leave unset to skip integration tests.
# TEST_MONGODB_URI=
